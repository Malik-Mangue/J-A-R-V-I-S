# ---------------------------------------------------------------------------
# Personal Second Brain - environment configuration
# Copy to `.env.local` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL is the source of truth) --------------------------
# Leave DATABASE_URL empty to use the embedded PostgreSQL engine (PGlite),
# which persists to ./.data/pgdata. Provide a postgres:// URL to use a real
# PostgreSQL server instead (same SQL, same migrations).
# DATABASE_URL=postgres://user:password@localhost:5432/second_brain
PGLITE_DATA_DIR=./.data/pgdata

# --- User / locale ----------------------------------------------------------
# Single-user mode for now; the id exists so entities are future-proof.
DEFAULT_USER_ID=user_local
# IANA timezone used for temporal interpretation.
APP_TIMEZONE=Africa/Maputo
APP_LOCALE=pt-MZ

# --- AI provider ------------------------------------------------------------
# `rule` (default, offline, deterministic) or `openai` (OpenAI-compatible).
AI_PROVIDER=rule
AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Transcription provider ------------------------------------------------
# `none` (default) or `openai` (Whisper-compatible endpoint).
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_MODEL=whisper-1
# OPENAI_API_KEY=

# --- Obsidian projection (optional, not required for core operation) -------
# OBSIDIAN_VAULT_PATH=/path/to/vault
